# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host srv2
    HostName srv2.shayani.net
    User shayani
    Port 2205

Host srv4
    HostName srv4.bahai.org.br
    User shayani
    Port 2205

Host eventaservo
    HostName srv1.eventaservo.org
    User eventaservo
    Port 2205

Host home1
    HostName home1.eland-neon.ts.net
    User shayani
    Port 22

Host home2
    HostName home2.eland-neon.ts.net
    User shayani
    Port 22

Match all
  Include ~/.ssh/codespaces

Host codespace
    HostName cs.congenial-winner-pj45p5p4q63qg9.main
    User vscode
    IdentityFile ~/.ssh/codespaces.auto
    ProxyCommand gh cs ssh -c congenial-winner-pj45p5p4q63qg9 --stdio -- -i ~/.ssh/codespaces.auto
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking no
