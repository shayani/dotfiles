{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/f-balanced",
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "env": ["OMNIROUTE_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://omniroute.eland-neon.ts.net/v1"
      },
      "models": {
        "fernando-chat-daily": {},
        "fernando-coding": {},
        "fernando-reasoning": {},
        "f-free": {},
        "f-chat-super": {},
        "f-local": {},
        "f-padrao": {},
        "f-balanced": {
          "limit": {
            "context": 872000,
            "input": 872000,
            "output": 384000
          },
          "cost": {
            "input": 1,
            "output": 5,
            "cache": {
              "read": 0.05,
              "write": 1.25
            }
          }
        },
        "f-fast": {},
        "ollama/ornith-1.5:35b": {},
        "ollama/ornith-1.5:9b": {},
        "ollama/gemma4:26b-mlx": {},
        "ollama/gemma4:e4b-mlx": {},
        "ollama/qwen3.8:27b-mlx": {},
        "ollama/gpt-oss:20b": {},
        "ollama/granite4.2:3b": {}
      }
    }
  }
}
