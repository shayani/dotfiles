{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/f-balanced",
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "env": ["OMNIROUTE_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://omniroute.eland-neon.ts.net/v1"
      },
      "models": {
        "fernando-chat-daily": {
          "limit": { "context": 872000, "input": 872000, "output": 128000 },
          "cost": { "input": 0.75, "output": 3.75, "cache": { "read": 0.075, "write": 0.75 } }
        },
        "fernando-coding": {
          "limit": { "context": 872000, "input": 872000, "output": 128000 },
          "cost": { "input": 2.5, "output": 15, "cache": { "read": 0.25, "write": 3.125 } }
        },
        "fernando-reasoning": {
          "limit": { "context": 872000, "input": 872000, "output": 128000 },
          "cost": { "input": 0.75, "output": 3.75, "cache": { "read": 0.075, "write": 0.75 } }
        },
        "f-free": {
          "cost": { "input": 0, "output": 0 }
        },
        "f-chat-super": {
          "limit": { "context": 872000, "input": 872000, "output": 128000 },
          "cost": { "input": 0.75, "output": 3.75, "cache": { "read": 0.075, "write": 0.75 } }
        },
        "f-local": {},
        "f-padrao": {
          "limit": { "context": 872000, "input": 872000, "output": 128000 },
          "cost": { "input": 0.1, "output": 0.5, "cache": { "read": 0.01, "write": 0.125 } }
        },
        "f-balanced": {
          "limit": { "context": 872000, "input": 872000, "output": 384000 },
          "cost": { "input": 1, "output": 5, "cache": { "read": 0.05, "write": 1.25 } }
        },
        "f-fast": {
          "limit": { "context": 872000, "input": 872000, "output": 128000 },
          "cost": { "input": 0.1, "output": 0.5, "cache": { "read": 0.01, "write": 0.125 } }
        },
        "ollama/ornith-1.5:35b": {
          "limit": { "context": 128000 },
          "cost": { "input": 0, "output": 0 }
        },
        "ollama/ornith-1.5:9b": {
          "limit": { "context": 128000 },
          "cost": { "input": 0, "output": 0 }
        },
        "ollama/gemma4:26b-mlx": {
          "limit": { "context": 128000 },
          "cost": { "input": 0, "output": 0 }
        },
        "ollama/gemma4:e4b-mlx": {
          "limit": { "context": 128000 },
          "cost": { "input": 0, "output": 0 }
        },
        "ollama/qwen3.8:27b-mlx": {
          "limit": { "context": 128000 },
          "cost": { "input": 0, "output": 0 }
        },
        "ollama/gpt-oss:20b": {
          "limit": { "context": 400000 },
          "cost": { "input": 0, "output": 0 }
        },
        "ollama/granite4.2:3b": {
          "limit": { "context": 128000 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  }
}
